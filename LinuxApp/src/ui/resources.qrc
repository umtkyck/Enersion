<RCC>
    <qresource prefix="/">
        <!-- Main QML -->
        <file alias="ui/qml/main.qml">qml/main.qml</file>
        <file alias="ui/qml/Style.qml">qml/Style.qml</file>
        <file alias="ui/qml/qmldir">qml/qmldir</file>
        
        <!-- Components -->
        <file alias="ui/qml/components/NavigationBar.qml">qml/components/NavigationBar.qml</file>
        <file alias="ui/qml/components/TopBar.qml">qml/components/TopBar.qml</file>
        <file alias="ui/qml/components/Card.qml">qml/components/Card.qml</file>
        <file alias="ui/qml/components/DioChannel.qml">qml/components/DioChannel.qml</file>
        <file alias="ui/qml/components/DioGrid.qml">qml/components/DioGrid.qml</file>
        <file alias="ui/qml/components/PrimaryButton.qml">qml/components/PrimaryButton.qml</file>
        
        <!-- Pages -->
        <file alias="ui/qml/pages/DashboardPage.qml">qml/pages/DashboardPage.qml</file>
        <file alias="ui/qml/pages/DigitalInputPage.qml">qml/pages/DigitalInputPage.qml</file>
        <file alias="ui/qml/pages/DigitalOutputPage.qml">qml/pages/DigitalOutputPage.qml</file>
        <file alias="ui/qml/pages/SettingsPage.qml">qml/pages/SettingsPage.qml</file>
    </qresource>
</RCC>

